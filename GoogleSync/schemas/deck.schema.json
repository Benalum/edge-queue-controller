{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "app_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "card_count_declared": {
      "type": "integer"
    },
    "card_count_verified_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "deck_id": {
      "type": "string"
    },
    "default_daily_target": {
      "type": [
        "integer",
        "null"
      ]
    },
    "default_study_mode": {
      "enum": [
        "flashcards",
        "companion",
        "mixed",
        "review"
      ],
      "type": "string"
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "device_id": {
      "type": "string"
    },
    "owner_subject_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_id": {
      "type": "string"
    },
    "record_type": {
      "const": "deck",
      "type": "string"
    },
    "revision": {
      "type": [
        "integer",
        "string"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "source": {
      "enum": [
        "apc_native",
        "anki_local_import",
        "anki_browser_local",
        "companion_session",
        "manual_edit",
        "sync_merge",
        "sync_engine",
        "migration"
      ],
      "type": "string"
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "apc_native",
        "anki_local_import",
        "generated"
      ],
      "type": "string"
    },
    "tags": {
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "created_at",
    "updated_at",
    "device_id",
    "revision",
    "source",
    "content_hash",
    "deck_id",
    "title",
    "source_type",
    "card_count_declared"
  ],
  "title": "APC GoogleSync Deck",
  "type": "object",
  "x_apc_scope": "local_schema_validation_only",
  "x_apc_stage": "17K-Z-R4",
  "x_no_drive_writes": true,
  "x_no_oauth": true
}
