[Unit]
Description=Run Edge Queue worker remediation tick
After=edge-queue-controller.service
Requires=edge-queue-controller.service

[Service]
Type=oneshot
TimeoutStartSec=25
RuntimeMaxSec=30
ExecStart=/usr/bin/flock -n /tmp/edge-queue-remediation-tick.lock /usr/bin/curl -fsS --connect-timeout 2 --max-time 20 -X POST http://127.0.0.1:7070/workers/remediation/tick
