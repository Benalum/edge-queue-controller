[Unit]
Description=Run Edge Queue scheduler tick
Wants=edge-queue-controller.service
After=edge-queue-controller.service network-online.target

[Service]
Type=oneshot
User=alex
WorkingDirectory=/home/alex/Desktop/edge-queue-controller
ExecStart=/usr/bin/bash -lc 'curl -fsS --retry 3 --retry-delay 2 --max-time 300 -X POST http://127.0.0.1:7070/tick'
