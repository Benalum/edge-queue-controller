# Rewarded ads live template.
# Use only after Google approval and after creating the rewarded ad unit in Google Ad Manager.

AD_REWARD_FREE_CREDITS=5
AD_REWARD_DAILY_LIMIT=25
AD_REWARD_MONTHLY_LIMIT=750
AD_REWARD_COOLDOWN_SECONDS=120

AD_REWARD_MOCK_ENABLED=false

AD_REWARD_PROVIDER=google_gpt
AD_REWARD_GOOGLE_GPT_ENABLED=true

# Replace this with the real Google Ad Manager GPT ad unit path:
# Format: /NETWORK_CODE/AD_UNIT_CODE
# Example: /1234567/credits_rewarded
AD_REWARD_GOOGLE_GPT_AD_UNIT_PATH=/REPLACE_WITH_NETWORK_CODE/REPLACE_WITH_REWARDED_AD_UNIT

# Keep false until the first ad loads successfully in the browser.
AD_REWARD_CLIENT_CLAIM_ENABLED=false

# Keep false for the current web GPT implementation.
# If later we add a real server-side provider verification flow, then revisit this.
AD_REWARD_PROVIDER_VERIFICATION_ENABLED=false

# Keep false until final controlled logged-in claim test.
ENABLE_PUBLIC_AD_REWARD_ROUTES=false
