# Edge queue controller example config
# Copy to .env and fill real values locally.
# Do not commit real .env files.

# General behavior
EDGE_DRY_RUN=true
EDGE_FORWARD_JOBS=true
EDGE_HOST=0.0.0.0
EDGE_PORT=7070

# Inventory-based routing
EDGE_INVENTORY_FILE=edge_inventory.json

# Wake/start behavior
EDGE_WAKE_ENABLED=false
EDGE_START_GUESTS_ENABLED=false
EDGE_START_GUESTS_DRY_RUN=true

# Legacy/default host check and forwarding
HOST_CHECK_URL=http://your-ai-platform-host:3010
AI_PLATFORM_BASE_URL=http://your-ai-platform-host:3010
AI_PLATFORM_EDGE_INGEST_URL=http://your-ai-platform-host:3010/api/backend/internal/edge/jobs

# Shared token used by edge queue to submit jobs to AI platform
EDGE_SHARED_SECRET=change_me

# Wake-on-LAN defaults
PROXMOX_WAKE_MAC=change_me
PROXMOX_WAKE_BROADCAST=192.168.0.255
PROXMOX_WAKE_PORT=9

# Worker start over SSH
WORKER_START_ENABLED=true
WORKER_START_DRY_RUN=false
WORKER_START_SSH_HOST=your-worker-host
WORKER_START_SSH_USER=root
WORKER_START_SSH_KEY=/home/alex/.ssh/edge_queue_llms
WORKER_START_COMMAND=/usr/local/sbin/ai-platform-start-worker

# Shared token required for workers to report resource heartbeats.
HEARTBEAT_SHARED_SECRET=change_me

# Rewarded ads
# Real web rewarded ads should remain free/local credits only.
AD_REWARD_FREE_CREDITS=5
AD_REWARD_DAILY_LIMIT=25
AD_REWARD_MONTHLY_LIMIT=750
AD_REWARD_COOLDOWN_SECONDS=120

# Local testing only.
AD_REWARD_MOCK_ENABLED=false

# Provider config.
# For web, Google Publisher Tag rewarded ads can emit browser reward events.
# Keep public claiming disabled until the frontend integration is ready.
AD_REWARD_PROVIDER=none
AD_REWARD_GOOGLE_GPT_ENABLED=false
AD_REWARD_GOOGLE_GPT_AD_UNIT_PATH=
AD_REWARD_CLIENT_CLAIM_ENABLED=false
AD_REWARD_PROVIDER_VERIFICATION_ENABLED=false

# Email verification
# Pending signups do not create app_users until the user verifies their email.
PUBLIC_BASE_URL=https://buddieswhostudy.com
EMAIL_VERIFICATION_TOKEN_MINUTES=15
# Legacy fallback if TOKEN_MINUTES is not set.
EMAIL_VERIFICATION_TOKEN_HOURS=24
EMAIL_VERIFICATION_DEBUG_RETURN_URL=false

# SMTP sending. Keep disabled until real SMTP values are configured.
EMAIL_VERIFICATION_SMTP_ENABLED=false
EMAIL_FROM=no-reply@buddieswhostudy.com
EMAIL_FROM_NAME=Buddies Who Study
EMAIL_VERIFICATION_SUBJECT=Verify your email address
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Password reset
PASSWORD_RESET_TOKEN_MINUTES=15
# Legacy fallback if TOKEN_MINUTES is not set.
PASSWORD_RESET_TOKEN_HOURS=1
PASSWORD_RESET_SUBJECT=Reset your password
