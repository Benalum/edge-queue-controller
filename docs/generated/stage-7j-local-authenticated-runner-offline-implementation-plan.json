{
  "stage": "7J",
  "name": "local_authenticated_runner_offline_implementation",
  "runtime_behavior_change": false,
  "phase": "authenticated_shadow_comparison_guardrails",
  "purpose": "Create the future authenticated shadow comparison runner as a manually invoked ops tool that is offline-only by default and not runtime-wired.",
  "runner": {
    "path": "ops/compare/run-authenticated-shadow-comparison.py",
    "created_in_this_stage": true,
    "manual_ops_tool_only": true,
    "offline_by_default": true,
    "authenticated_http_execution_requires_explicit_flag": true,
    "state_changing_route_call_requires_explicit_confirmation": true,
    "runtime_wired": false,
    "http_endpoint_exposed": false,
    "frontend_wired": false,
    "backend_wired": false,
    "gateway_wired": false,
    "systemd_wired": false
  },
  "supported_domains": [
    "study",
    "companion"
  ],
  "supported_cases": [
    {
      "case": "study_next",
      "domain": "study",
      "route": "/api/study/session/command",
      "helper": "_stage6q_study_adapter_shadow",
      "default_payload_summary": "next command"
    },
    {
      "case": "companion_chat",
      "domain": "companion",
      "route": "/api/companion/chat",
      "helper": "_stage6v_companion_adapter_shadow",
      "default_payload_summary": "safe companion chat example"
    }
  ],
  "auth_policy": {
    "auth_required_only_for_execute_authenticated": true,
    "allowed_auth_environment": [
      "EDGE_AUTH_SHADOW_COMPARE_COOKIE",
      "EDGE_AUTH_SHADOW_COMPARE_BEARER"
    ],
    "secret_values_may_be_printed": false,
    "secret_values_may_be_stored": false,
    "raw_authenticated_response_stored": false
  },
  "artifact_policy": {
    "schema_version": "stage-7c-v1",
    "validator": "ops/validate/validate-authenticated-shadow-comparison-artifact.py",
    "validate_before_success": true,
    "store_raw_response": false,
    "store_auth_values": false,
    "store_secret_values": false
  },
  "required_runtime_state": {
    "router_endpoint_disabled_by_default": true,
    "expected_router_disabled_http_code": 404,
    "dispatch_enabled": false,
    "model_calls_enabled": false,
    "runtime_wiring_changed": false
  },
  "safety_invariants": [
    "runner is manual ops-only",
    "runner is offline by default",
    "runner is not imported by runtime handlers",
    "runner is not exposed as an HTTP endpoint",
    "runner is not wired into frontend, backend, gateway, or systemd",
    "runner does not print auth cookies or bearer tokens",
    "runner does not store auth cookies or bearer tokens",
    "runner writes only sanitized artifacts",
    "runner validates artifacts before reporting success",
    "router dispatch remains disabled",
    "router model calls remain disabled"
  ]
}
